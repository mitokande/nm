{
  "expo": {
    "name": "Number Match",
    "slug": "number-match",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f5efe6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mithatcanturan.numbermatch",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "GADDelayAppMeasurementInit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f5efe6"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.mithatcanturan.numbermatch"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#ec7458"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4604843322018757~6145619448",
          "iosAppId": "ca-app-pub-4604843322018757~1702676089"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a211c348-5ff9-4efc-98d8-8f5d4a89f67b"
      }
    }
  }
}
